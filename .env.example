# SnapUp configuration.
#
# Copy to `.env.local` in the app you are running and fill in. Every secret below has a
# dev-only fallback that the app refuses to use in production, so local development works
# with an empty file.
#
# Never commit a filled-in copy. This file is the template; `.env.local` is gitignored.

# ---------------------------------------------------------------------------
# Secrets — required in production
# ---------------------------------------------------------------------------
# Each signs a different token with a different lifetime and blast radius. Separate
# values on purpose: rotating the session secret to kick live sessions should not also
# invalidate every basket queued at the exit gate.
SNAPUP_QR_SECRET=
SNAPUP_SESSION_SECRET=
SNAPUP_EXIT_TOKEN_SECRET=

# Presented by the admin console's server when writing to the store registry. Never
# exposed to its browser bundle — a token in client JavaScript is a public token.
SNAPUP_ADMIN_API_TOKEN=

# ---------------------------------------------------------------------------
# Retail API — platform-wide
# ---------------------------------------------------------------------------
# The deployment model: the retailer hosts the database and gives SnapUp an API key
# rather than a connection string. We hold none of their data, only a short-lived cache.
#
# Set these when the chain runs ONE central system. They are also the fallback for any
# branch that has no endpoint of its own, and the store *registry* always uses them —
# resolving a branch's endpoint requires reading that branch's record, so the registry
# cannot be routed per branch without a cycle.
SNAPUP_STORE_API_BASE=
SNAPUP_STORE_API_KEY=

# Per-attempt budget in ms. Requirement 3 asks for a barcode lookup inside ~2s end to
# end, and that now includes a round trip to somebody else's infrastructure.
SNAPUP_STORE_API_TIMEOUT_MS=800

# ---------------------------------------------------------------------------
# Retail API — per branch
# ---------------------------------------------------------------------------
# Only needed when a branch runs its own system rather than sharing a central one.
#
# A store record holds `apiKeyRef`, which is the NAME of the variable below — never the
# key. The registry is editable in the console, returned by the admin API, and on
# Postgres sits in a backed-up table; a credential on that path is a credential that
# leaks. The reference is worthless without this file.
#
# `apiKeyRef: 'KMB_TRICHY'` resolves to SNAPUP_STORE_API_KEY_KMB_TRICHY.
#
# A branch naming a reference that cannot be resolved fails with `not_configured`. It
# does NOT fall back to the platform key — that would send one branch's request
# authenticated as another, which is a cross-tenant call, not a graceful degradation.

SNAPUP_STORE_API_KEY_KMB_TRICHY=
SNAPUP_STORE_API_KEY_KMB_THANJAVUR_1=
SNAPUP_STORE_API_KEY_KMB_THANJAVUR_2=
SNAPUP_STORE_API_KEY_KMB_KUMBAKONAM=
SNAPUP_STORE_API_KEY_KMB_MAYILADUTHURAI=
SNAPUP_STORE_API_KEY_KMB_PUDUKKOTTAI=
SNAPUP_STORE_API_KEY_KMB_MANNARGUDI=
SNAPUP_STORE_API_KEY_KMB_NATCHIARKOIL=

# Base URLs may be set here or on the store record in the admin console. The record is
# usually better — it changes without a redeploy. These take effect only when the record
# leaves `apiBaseUrl` blank.
# SNAPUP_STORE_API_BASE_KMB_TRICHY=https://trichy.example.com/api
# SNAPUP_STORE_API_BASE_KMB_THANJAVUR_1=https://tj1.example.com/api

# ---------------------------------------------------------------------------
# Database — used only when no retail API is configured
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# Development only
# ---------------------------------------------------------------------------
# Skips the egress-IP presence check. Ignored in production builds — but it disables the
# control that stops someone shopping a store from their sofa, so never set it on a
# deployed environment.
SNAPUP_PRESENCE_DEV_BYPASS=0

# ---------------------------------------------------------------------------
# Accounts
# ---------------------------------------------------------------------------
# Signs the account session — who you are logged in as. Separate from the shopping
# session secret on purpose: rotating this signs everyone out of their account without
# also dropping every basket live on a shop floor.
#
# The account session has NO expiry. You stay signed in until you log out. That is safe
# because it grants identity only: the catalogue still needs a shopping session, which is
# IP-bound and capped at 30 minutes.
SNAPUP_ACCOUNT_SECRET=

# Peppers the stored hash of a one-time code. Six digits is a million candidates, which a
# plain hash gives up instantly — this is what makes a leaked challenge row useless
# without also leaking the environment. Never stored in the database.
SNAPUP_OTP_PEPPER=

# How OTPs reach customers. `log` prints the code to the server console, which is what
# makes sign-in testable with no SMS account. `sms` is the real path and currently throws
# until a provider is wired into accounts/otp.ts — a stub that silently succeeded would
# make a broken pilot look like a working one.
#
# Defaults to `log` outside production and `sms` inside it, so shipping without setting
# this fails loudly rather than quietly printing customers' codes into a shared log.
SNAPUP_OTP_DELIVERY=log

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Two backends, chosen by URL scheme. The repositories cannot tell them apart.
#
#   file:./.data/snapup        embedded PostgreSQL (PGlite) — real Postgres compiled to
#                             WASM, running in this process, persisted to that directory.
#                             Nothing to install. ONE PROCESS ONLY: the app takes an
#                             exclusive lock, because a second opener silently reverts the
#                             first one's writes.
#
#   postgresql://user:pw@host/db   hosted Postgres over the Neon HTTP driver. Use this for
#                             anything with more than one instance.
#
# Unset means the in-memory repositories: accounts vanish on restart, and in Next dev a
# route recompile is enough. Fine for the validation harness, not for a pilot.
DATABASE_URL=file:./.data/snapup

# ---------------------------------------------------------------------------
# Password recovery (console accounts only)
# ---------------------------------------------------------------------------
# Customers sign in with a phone and a one-time code, so they have no password to reset —
# the most commonly abused recovery flow does not exist for them.
#
# `log` writes the reset link to the server console, which is what makes recovery testable
# with no mail account. `email` is the real path and throws until a provider is wired into
# accounts/reset.ts. Defaults to `log` outside production and `email` inside it.
SNAPUP_RESET_DELIVERY=log

# Origin the reset link points at — the CONSOLE, not the API. They are different origins,
# and a link to the wrong one 404s after the user has been told to check their email.
SNAPUP_CONSOLE_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# SMS (MSG91)
# ---------------------------------------------------------------------------
# Both are required together. With only one set the app logs an error and falls back to
# the log sender — which means no customer receives a code, so a half-configured
# deployment says so rather than failing silently at the till.
#
# India requires a DLT-registered template: the operator rejects free text whatever the
# API returns. Register one reading roughly
#
#   ##OTP## is your SnapUp verification code. Valid for 5 minutes. Do not share it.
#
# The variable name in the template must match the one sent in accounts/otp.ts (`OTP`).
SNAPUP_MSG91_AUTH_KEY=
SNAPUP_MSG91_TEMPLATE_ID=
SNAPUP_MSG91_SENDER_ID=

# ---------------------------------------------------------------------------
# Rate limiting (shared, for multi-instance deployments)
# ---------------------------------------------------------------------------
# Without these, limits are counted PER INSTANCE. On serverless the effective limit
# becomes capacity x instance count — and instances scale up under load, so the harder an
# endpoint is hammered the weaker its limit gets. Exactly backwards.
#
# Matters most on otp/request (spends money on an SMS, lands on someone's phone) and
# console/login (the front door to the store registry).
#
# REST rather than a Redis client, for the same reason the database uses Neon's HTTP
# driver: a connection pool per serverless instance exhausts the server first.
#
# Both are required together; setting one logs an error and falls back to per-instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
